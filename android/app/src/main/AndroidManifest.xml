<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Requerido para cualquier llamada de red (Dio al backend, socket TCP a la
         impresora de etiquetas) — sin esto Android bloquea la red en release. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Requerido por mobile_scanner para leer códigos de barra con la cámara -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <!-- Auto-actualización (feature "actualizacion"): permite pedirle al
         sistema que instale el .apk que la app se descarga sola desde
         /ajustes/sistema/app-android. Sin esto Android bloquea el intent de
         instalación aunque el usuario ya haya habilitado "instalar apps
         desconocidas" para esta app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Requerido desde Android 13 (API 33) para mostrar notificaciones push
         (FCM) — sin esto el sistema las descarta en silencio aunque el
         usuario nunca haya dicho que no. firebase_messaging pide el permiso
         en tiempo de ejecución (`requestPermission()`), esto solo lo declara. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="RS - WH"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Ícono por defecto para las notificaciones push que llegan con la
             app en background/cerrada (Android las muestra solo). Tiene que
             ser blanco sobre transparente: Android ignora el color y tiñe
             todo lo opaco con un solo color (ver default_notification_color
             abajo); usar el logo a color tal cual (como estaba antes, con
             @mipmap/launcher_icon) se ve como un blob blanco sin forma. Ver
             wherehouse/android/app/src/main/res/drawable-*dpi/ic_notification.png,
             generado a partir de assets/images/app_icon_foreground.png
             (solo el barco+ola, sin el anillo ni el texto "RIVER SUPPLY":
             a 24dp ese detalle se pierde y queda ilegible). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Necesario en Android 11+ (package visibility) para que el intent
             que abre open_filex resuelva el instalador de paquetes del
             sistema al tocar "Actualizar ahora". -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="application/vnd.android.package-archive"/>
        </intent>
    </queries>
</manifest>
