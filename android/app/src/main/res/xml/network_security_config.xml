<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ (API 28+) bloquea tráfico HTTP sin cifrar por defecto. El
  backend FastAPI corre en plano HTTP dentro de la LAN (192.168.100.97:8000
  — ver core/config/env.dart), así que sin esto la app no puede conectarse
  desde un teléfono real (sí funcionaba en emulador Android porque, aparte
  de la IP, el bloqueo de cleartext también depende de configuración del
  propio emulador). Se habilita cleartext solo para la IP del servidor, no
  en general.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.100.97</domain>
    </domain-config>
</network-security-config>
